# Database
POSTGRES_USER=auditai
POSTGRES_PASSWORD=auditai_secret
POSTGRES_DB=auditai
DATABASE_URL=postgresql://auditai:auditai_secret@localhost:5432/auditai

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
