# Database — dev default is SQLite; production points at PostgreSQL+PostGIS
DATABASE_URL=sqlite:///./data/agroprofit.db
# DATABASE_URL=postgresql+psycopg2://agroprofit:agroprofit@postgres:5432/agroprofit

FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET_KEY=change-me-in-production

# Provider licensing / feature flags (spec seção 4 e 52)
ALLOW_NON_COMMERCIAL_PROVIDERS=true
ENABLE_EARTH_ENGINE=false
DEFAULT_GRID_RESOLUTION_M=30

# Optional commercial/credentialed providers — leave blank to disable, the
# ProviderRouter falls back automatically (spec seção 52).
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
OPENWEATHER_API_KEY=
TOMORROW_API_KEY=
PLANET_API_KEY=
CDS_API_KEY=
