# ── PEC Observation App — Pré-Produção Environment ───────────────────────────
# Copy to .env.preprod and fill in real values before running.

# Postgres (Cloud SQL via Cloud Run connector)
DATABASE_URL=postgresql://pec:FILL_BEFORE_DEPLOY@/pec_identity?host=/cloudsql/FILL_GCP_PROJECT:southamerica-east1:pec-stg-db

# Redis (Memorystore)
REDIS_URL=redis://FILL_MEMORYSTORE_IP:6379/0

# GCS Buckets
GCS_BUCKET_AUDIO=pec-stg-audio
GCS_BUCKET_PDF=pec-stg-pdf

# JWT
SECRET_KEY=FILL_BEFORE_DEPLOY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — origens permitidas
CORS_ORIGINS=https://pec-stg.seduc.sp.gov.br

# Admin inicial
ADMIN_EMAIL=admin-stg@pec.seduc.sp.gov.br
ADMIN_PASSWORD=FILL_BEFORE_DEPLOY

# Ollama
OLLAMA_BASE_URL=http://FILL_OLLAMA_VM_IP:11434
OLLAMA_MODEL=pec-pedagogo
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Telemetry
OTEL_EXPORTER_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://FILL_OTEL_ENDPOINT

# LGPD
AUDIT_RETENTION_DAYS=90
