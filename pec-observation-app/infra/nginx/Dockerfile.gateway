# Builds the React web-app and embeds it in the nginx API gateway image.
# The resulting single image serves static files AND proxies /api/v1/* to microservices.

# ── Stage 1: Build React web-app ─────────────────────────────────────────────
FROM node:20-alpine AS web-builder
WORKDIR /app

COPY web-app/package.json web-app/package-lock.json* ./
RUN npm ci --prefer-offline

COPY web-app/ .

# All API URLs are empty (same-origin) — nginx gateway routes /api/v1/* internally
ARG VITE_IDENTITY_URL=""
ARG VITE_SCHOOL_URL=""
ARG VITE_OBSERVATION_URL=""
ARG VITE_AUDIO_URL=""
ARG VITE_FEEDBACK_URL=""
ARG VITE_KNOWLEDGE_URL=""
ARG VITE_BEST_PRACTICES_URL=""

ENV VITE_IDENTITY_URL=$VITE_IDENTITY_URL \
    VITE_SCHOOL_URL=$VITE_SCHOOL_URL \
    VITE_OBSERVATION_URL=$VITE_OBSERVATION_URL \
    VITE_AUDIO_URL=$VITE_AUDIO_URL \
    VITE_FEEDBACK_URL=$VITE_FEEDBACK_URL \
    VITE_KNOWLEDGE_URL=$VITE_KNOWLEDGE_URL \
    VITE_BEST_PRACTICES_URL=$VITE_BEST_PRACTICES_URL

RUN npm run build

# ── Stage 2: nginx gateway ────────────────────────────────────────────────────
FROM nginx:1.27-alpine

# Copy built SPA
COPY --from=web-builder /app/dist /usr/share/nginx/html

# Copy gateway routing config
COPY infra/nginx/gateway.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
