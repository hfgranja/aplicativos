# ─── Infrastructure ───────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=pec
POSTGRES_PASSWORD=pec_secret

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_AUDIO=audio-uploads
MINIO_BUCKET_PDF=pdf-exports

# ─── Auth (shared across all services) ────────────────────────
SECRET_KEY=change-me-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Seed admin ────────────────────────────────────────────────
ADMIN_EMAIL=admin@pec.seduc.sp.gov.br
ADMIN_PASSWORD=changeme123

# ─── Observability ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_ENABLED=false

# ─── LLM ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
# Base generative model pulled by ollama-init on first start
OLLAMA_MODEL=llama3.2
# Embedding model for MS-013 Learning Engine (768-dim vectors)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional: swap to Anthropic
ANTHROPIC_API_KEY=

# ─── Learning Engine (MS-013) ─────────────────────────────────
# Name for the continuously improved pedagogical model built from approved feedback
PEC_MODEL_NAME=pec-pedagogo
# Rebuild model after this many new approved feedback examples accumulate
REBUILD_THRESHOLD=5
# Internal URL for MS-013 (used by MS-006, MS-007, MS-011)
LEARNING_SERVICE_URL=http://ms-013-learning:8000

# ─── Model Evaluator (MS-014) ─────────────────────────────────
# Quality score below which model is flagged as degraded (0.0–1.0)
QUALITY_ALERT_THRESHOLD=0.60
# Internal URL for MS-014 (used by MS-007 on feedback approval)
EVALUATOR_SERVICE_URL=http://ms-014-evaluator:8000

# ─── Transcription ────────────────────────────────────────────
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ─── LGPD Retention ───────────────────────────────────────────
AUDIO_RETENTION_DAYS=7

# ─── iOS App API base URL ─────────────────────────────────────
# Set this in Xcode Info.plist as PEC_API_BASE_URL
# PEC_API_BASE_URL=http://localhost:8001

# ─── SEDUC Daily Crawler (MS-011) ─────────────────────────────
# Time to run the daily crawl (America/Sao_Paulo timezone)
CRAWLER_HOUR=6
CRAWLER_MINUTE=0
# Override crawl sources as JSON (leave empty to use built-in SEDUC/EFAPE defaults)
# Example: [{"name":"Custom","url":"https://example.com","selector":"article","type":"seduc_policy","index_only":true}]
SEDUC_CRAWLER_SOURCES=
