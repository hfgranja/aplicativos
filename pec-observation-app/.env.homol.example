# ── PEC Observation App — Homologação Environment ────────────────────────────
# Copy to .env.homol and fill in real values before running.

# Postgres
POSTGRES_USER=pec
POSTGRES_PASSWORD=FILL_BEFORE_DEPLOY
POSTGRES_DB=pec_identity

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / GCS (homol usa MinIO local)
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=FILL_BEFORE_DEPLOY
MINIO_ROOT_PASSWORD=FILL_BEFORE_DEPLOY
MINIO_BUCKET_AUDIO=pec-audio-hom
MINIO_BUCKET_PDF=pec-pdf-hom

# JWT — gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=FILL_BEFORE_DEPLOY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — origens permitidas (separadas por vírgula)
CORS_ORIGINS=https://pec-hom.seduc.sp.gov.br

# Admin inicial
ADMIN_EMAIL=admin-hom@pec.seduc.sp.gov.br
ADMIN_PASSWORD=FILL_BEFORE_DEPLOY

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=pec-pedagogo
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Telemetry (opcional em homol)
OTEL_EXPORTER_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Audit
AUDIT_RETENTION_DAYS=90
